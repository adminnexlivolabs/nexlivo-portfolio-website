# Contact form delivery. Without these the form returns a 503 and the UI
# directs visitors to the email and phone links instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=admin.nexlivolabs@gmail.com
CONTACT_FROM_EMAIL=

# Public origin of the deployed site. Used as metadataBase so og:image resolves
# to an absolute URL for LinkedIn/Slack/WhatsApp. Defaults to
# http://localhost:3000 when unset, which is correct for local development but
# NOT for production — set this on the deploy target.
NEXT_PUBLIC_SITE_URL=
